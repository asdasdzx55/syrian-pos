<Application x:Class="AlmanzilSouriPos.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Primary Palette & Styles -->
            <SolidColorBrush x:Key="PrimaryDark" Color="#121214"/>
            <SolidColorBrush x:Key="PanelDark" Color="#1E1E24"/>
            <SolidColorBrush x:Key="CardDark" Color="#2A2A32"/>
            <SolidColorBrush x:Key="AccentGold" Color="#F4A261"/>
            <SolidColorBrush x:Key="AccentRed" Color="#E63946"/>
            <SolidColorBrush x:Key="AccentTeal" Color="#2A9D8F"/>
            <SolidColorBrush x:Key="TextWhite" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TextGray" Color="#A0A0AA"/>

            <Style TargetType="Window">
                <Setter Property="FlowDirection" Value="RightToLeft"/>
                <Setter Property="FontFamily" Value="Segoe UI, Cairo"/>
                <Setter Property="Background" Value="{StaticResource PrimaryDark}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
